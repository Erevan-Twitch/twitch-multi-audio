{
  "manifest_version": 3,
  "name": "Twitch Multi Audio",
  "version": "0.0.0",
  "description": "Capture tab audio and now-playing info, and send them to the local Twitch Multi Audio server.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open Twitch Multi Audio panel"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/media-session.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "spike-capture-tab": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" },
      "description": "Spike: capture this tab's audio"
    }
  },
  "permissions": ["sidePanel", "tabs", "activeTab", "storage", "scripting", "tabCapture", "offscreen", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
